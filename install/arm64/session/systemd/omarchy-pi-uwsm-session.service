[Unit]
Description=Omarchy Pi Sierra UWSM session on tty8
Wants=systemd-logind.service
After=systemd-logind.service systemd-user-sessions.service getty@tty8.service
Conflicts=getty@tty8.service
StartLimitIntervalSec=5min
StartLimitBurst=1

[Service]
Type=exec
User=sierra
PAMName=login
WorkingDirectory=/home/sierra
TTYPath=/dev/tty8
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
# TTYVHangup sends SIGHUP to the UWSM launcher on tty8. The first manual
# stop showed UWSM then stopping its graphical target and dependent RDP unit.
# Its ExecStop hook raced that teardown and attempted a second PAM session on
# the occupied VT, so shutdown is now driven by the observed tty hangup path.
TTYVHangup=yes
KillMode=control-group
TimeoutStopSec=45s
Restart=no
Environment=HOME=/home/sierra
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_DESKTOP=Hyprland
Environment=XDG_CURRENT_DESKTOP=Hyprland
Environment=AQ_NO_KMS_REQUIREMENT=1
# The bounded test switched to tty8 manually. Verify this privileged boot and
# console ordering, and the hangup-driven stop, in a manual unit trial before
# enabling this unit at boot.
ExecStartPre=+/usr/bin/chvt 8
ExecStart=/usr/bin/uwsm start -g -1 -U run -e -D Hyprland -- /usr/bin/start-hyprland -- --config /home/sierra/.config/hypr/hyprland.lua

[Install]
WantedBy=multi-user.target
