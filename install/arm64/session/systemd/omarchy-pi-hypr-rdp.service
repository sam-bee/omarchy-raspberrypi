[Unit]
Description=Omarchy Pi loopback hypr-rdp server
After=graphical-session.target
BindsTo=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
WorkingDirectory=~
UMask=0077
KillMode=control-group
TimeoutStopSec=15s
Restart=no
# The user manager supplies this account's UID, home and runtime directory.
# The verifier checks them against the process identity before opening RDP.
ExecStartPre=/usr/bin/python3 /usr/local/libexec/omarchy-pi/verify-hypr-rdp-runtime.py --uid %U --home ${HOME} --runtime %t
ExecStart=/usr/bin/hypr-rdp --config .config/omarchy-pi-rdp/config.toml

[Install]
WantedBy=graphical-session.target
