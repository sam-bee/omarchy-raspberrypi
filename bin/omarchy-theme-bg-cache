#!/bin/bash

# omarchy:summary=Cache background switcher thumbnails for the current theme

theme_name=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)

menu_args=()
if [[ ${OMARCHY_PI_MINIMAL_SESSION:-} == 1 ]]; then
  # The bounded Pi profile supports still backgrounds only; do not ask the
  # generic cache warmer to invoke the optional video thumbnailer there.
  menu_args+=(--still-only)
fi

omarchy-menu-images \
  "${menu_args[@]}" \
  --cache-only \
  "$HOME/.local/state/omarchy/current/theme/backgrounds" \
  "$HOME/.config/omarchy/backgrounds/$theme_name"
